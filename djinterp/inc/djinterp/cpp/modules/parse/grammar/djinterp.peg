################################################################################
#  djinterp — CLI / functional DSL surface grammar                             #
#  Parsing Expression Grammar (normative)                                      #
#                                                                              #
#  This is the surface syntax of the djinterp command language: a POSIX + GNU  #
#  command grammar, a find-style predicate algebra over those commands, a      #
#  value-threading pipeline, and a sequence separator -- one stratified        #
#  expression grammar whose weakest binder is the sequence and whose strongest #
#  is a primary (a parenthesized group, a command, or a literal).              #
#                                                                              #
#  WHY PEG.  The language is defined by committed ordered choice: where two    #
#  alternatives overlap, the first that matches wins and there is no backtrack #
#  past it, and repetition is greedy.  That is exactly the semantics of the    #
#  parser that implements it (the `or_` combinator and precedence climbing),   #
#  and it makes every longest-match decision -- `--` before `-`, `<=` before   #
#  `<`, the bare `--` option terminator -- a property of rule order rather     #
#  than an external side condition.  An ABNF (RFC 5234) or EBNF rendering is    #
#  available as a companion; there, alternation is unordered, so these orders  #
#  become normative notes attached to the grammar.                             #
#                                                                              #
#  TWO PHASES.  A lexical grammar turns characters into tokens (resolving the  #
#  option shapes, the keyword/word distinction, quoting, line ends and         #
#  whitespace); a syntactic grammar turns the token sequence into a term.      #
#  This mirrors the implementation: the interpreter's source (the interp       #
#  module) produces the tokens, and expression core v2 (parse/expr) builds the #
#  term, driven by the precedence table below, which is its signature; a       #
#  command and its arguments are read by the signature's command role.         #
#                                                                              #
#  NOTATION.                                                                   #
#    A <- e   rule            e1 e2   sequence          e1 / e2  ordered choice #
#    e*       zero or more    e+      one or more       e?       optional       #
#    &e       and-predicate (lookahead, consumes nothing)                       #
#    !e       not-predicate   [...]   char class   'x' "xy" literal   .  any    #
#                                                                              #
#  author(s): Samuel 'teer' Neal-Blim                        created: 2026.07.06 #
################################################################################


################################################################################
#  I.  LEXICAL GRAMMAR   (characters -> tokens)                                #
#                                                                              #
#  A token stream is produced by alternately discarding Skip and matching one  #
#  Token.  Order in Token is significant: the option shapes, the numbers and   #
#  the operator keywords are tried before WORD, so `--name`, `-xvf`, `and`,    #
#  `-1` and `123` never lex as bare words.  A token in a word's shape is that  #
#  token only where a word would end: followed by a character that would       #
#  continue a word (Joins), it is not, and the whole is a WORD -- `2file`,     #
#  `-x.txt`, `a==b`, `andes`.  WORD therefore captures exactly the             #
#  identifiers, paths, and operands that are neither an option, a keyword, nor #
#  a number.                                                                   #
################################################################################

Skip          <- (Blank / Comment / Continuation)+

Token         <- NEWLINE
               / LONG_OPTION
               / TERMINATOR
               / NUMBER
               / SHORT_OPTION
               / PIPE
               / SEMICOLON
               / LPAREN
               / RPAREN
               / LBRACE
               / RBRACE
               / COMPARE
               / AND / OR / NOT
               / STRING
               / WORD

#  ── line ends ───────────────────────────────────────────────────────────────
#  A newline is a token, not trivia: the syntactic grammar reads it as `;`
#  where a pipeline has just ended, and as a blank after an operator, an
#  opening bracket, or another newline (note 7).  A backslash before a newline
#  joins the two lines (Continuation).

NEWLINE       <- Newline

#  ── option shapes (GNU) ─────────────────────────────────────────────────────
#  Longest match first: LONG_OPTION and TERMINATOR (both `--`) precede NUMBER
#  and SHORT_OPTION (`-`), and a bare `--` (option terminator) is told from
#  `--name` by what follows it.  A word that is wholly a number is a NUMBER,
#  tried before SHORT_OPTION, so `-1` and `-1.5` are numbers; as a command's
#  arguments both are handed to the command as written (note 10).  `--name=`
#  is the option with the empty value.

LONG_OPTION   <- "--" OptionName ("=" OptionValue?)? !Joins
TERMINATOR    <- "--" !Joins                    # bare `--` ends options
SHORT_OPTION  <- "-" [A-Za-z0-9]+ !Joins        # -x , bundled -xvf

OptionName    <- NameChar+
OptionValue   <- WordPart+                      # to the end of the word

#  ── operators & keywords ────────────────────────────────────────────────────
#  An operator or a keyword spelled in word characters is that token only
#  standing alone, not continued by a character of a word: `a==b` and `<b` are
#  WORDs, as `andes` is.  A comparison operator is matched longest-first.
#  Brackets, braces, `|` and `;` are never part of a word.

PIPE          <- "|"
SEMICOLON     <- ";"
LPAREN        <- "("
RPAREN        <- ")"
LBRACE        <- "{"
RBRACE        <- "}"

COMPARE       <- ("==" / "!=" / "=~" / "<=" / ">=" / "<" / ">") !Joins

AND           <- "and" !Joins
OR            <- "or"  !Joins
NOT           <- "not" !Joins

#  ── literals & words ────────────────────────────────────────────────────────
#  A word is a run of parts -- bare characters, quoted strings and escaped
#  characters -- joined as `sh` joins them: `--name="a b"c` is one word, whose
#  value is `a bc` (note 8).  A word that is wholly one quoted part is a
#  STRING, a literal (note 4).

NUMBER        <- "-"? Digit+ ("." Digit+)? !Joins
STRING        <- Quoted !Joins                  # "..." or '...', alone
WORD          <- WordPart+                      # identifier / path / operand

WordPart      <- Quoted / Escaped / WordChar
Quoted        <- '"' (DqEscape / !'"' .)* '"'   # double-quoted
               / "'" (!"'" .)* "'"             # single-quoted: as written
DqEscape      <- "\\" ["\\]                    # \" and \\ in double quotes
Escaped       <- "\\" !Newline .               # a bare character, kept
Joins         <- WordChar / ["'] / "\\" !Newline # what would continue a word

WordChar      <- !Blank !Newline ![|;(){}"'\\] .  # `=` and `#` included
NameChar      <- !Blank !Newline ![|;(){}"'\\=] .
Digit         <- [0-9]

#  ── trivia ──────────────────────────────────────────────────────────────────
#  Trivia is discarded only between tokens, so a comment begins only where a
#  token could: never inside a word (note 11).

Blank         <- [ \t]
Newline       <- "\r\n" / "\n" / "\r"
Continuation  <- "\\" Newline                  # joins two lines
Comment       <- "#" (!Newline .)*


################################################################################
#  II.  SYNTACTIC GRAMMAR   (tokens -> term)                                   #
#                                                                              #
#  Runs over the token sequence (blanks and comments already removed; newlines #
#  kept).  Precedence is the rule cascade, weakest binder first: a Sequence is #
#  Pipelines joined by `;` or a newline, a Pipeline is OrExprs joined by `|`,  #
#  and so on down to a Primary.  The token names (LONG_OPTION, PIPE, AND, ...) #
#  are the terminals produced by the lexical grammar above.                    #
################################################################################

Program       <- NL* Sequence? EndOfTokens

#  sequence  (weakest)  --  `;` or a newline separates independent
#  pipelines; one may also end the sequence (note 7)
Sequence      <- Pipeline (Separator NL* Pipeline)* Separator? NL*
Separator     <- SEMICOLON / NEWLINE
NL            <- NEWLINE                       # a newline that is a blank

#  pipeline  --  `|` threads the value produced by the left into the right
Pipeline      <- OrExpr (PIPE NL* OrExpr)*

#  logical or / and  (left-associative)
OrExpr        <- AndExpr (OR NL* AndExpr)*
AndExpr       <- NotExpr (AND NL* NotExpr)*

#  logical not  (prefix)
NotExpr       <- NOT NL* NotExpr
               / Compare

#  comparison / match  (non-associative: at most one per level -- `a == b == c`
#  is rejected, parenthesize to nest)
Compare       <- Primary (COMPARE NL* Primary)?

#  primary  (strongest)
Primary       <- LPAREN NL* Sequence RPAREN       # grouping
               / Command                         # a POSIX+GNU invocation
               / Literal                         # a bare value

#  ── command surface (POSIX + GNU) ───────────────────────────────────────────
#  A command is a verb followed by options, operands and blocks.  Argument
#  scanning is greedy; it stops at the first token that is not an option, an
#  operand or a block -- an operator, a keyword, a closing bracket, a newline,
#  or the end of input -- because those are distinct token kinds, not words.
#  Each argument is handed to the command as written; the command's own parser
#  decides what it means (`-ofile`, `--k=v`, `-xvf`).

Command       <- Verb Argument*

Argument      <- LONG_OPTION
               / TERMINATOR
               / SHORT_OPTION
               / Block
               / Operand

#  a block: a sequence handed to the command as one argument, which runs it
#  as it says -- once for each item, or once (note 9)
Block         <- LBRACE NL* Sequence? RBRACE

Verb          <- WORD
Operand       <- WORD / NUMBER / STRING

Literal       <- NUMBER / STRING

EndOfTokens   <- !.


################################################################################
#  III.  PRECEDENCE & ASSOCIATIVITY                                            #
#                                                                              #
#  The cascade above encodes precedence structurally; this table states it     #
#  directly.  It is the signature expression core v2 parses and renders with:  #
#  each row is one operator.  Precedence increases with binding tightness (a   #
#  larger number binds tighter).                                               #
#                                                                              #
#    operator            precedence   associativity  fixity    role            #
#    ────────────────────────────────────────────────────────────────────────  #
#    ;   (newline)       10           left           infix     sequence        #
#    |                   20           left           infix     value pipeline  #
#    or                  30           left           infix     logical or      #
#    and                 40           left           infix     logical and     #
#    not                 50           --             prefix    logical not     #
#    == != =~            60           none           infix     equality / match#
#    <  <=  >  >=        60           none           infix     ordering        #
#    ( ) command lit     --           --             --        primary         #
#    { }                 --           --             --        block argument  #
#                                                                              #
#  Comparisons share precedence 60 and are non-associative: mixing them        #
#  without parentheses (e.g. `a < b == c`) is a syntax error.                  #
################################################################################


################################################################################
#  IV.  NOTES                                                                  #
#                                                                              #
#  1.  Ordered choice / longest match.  Every `/` is committed: the first      #
#      matching alternative wins with no backtracking past it.  The orderings  #
#      that matter are called out where they occur -- LONG_OPTION / TERMINATOR #
#      before NUMBER before SHORT_OPTION, and the COMPARE operators            #
#      longest-first -- and a token in a word's shape ends where a word ends   #
#      (`!Joins`).                                                             #
#                                                                              #
#  2.  Value pipeline.  `|` is not textual: each stage receives the value the  #
#      previous stage produced (PowerShell-flavored), and the pipeline         #
#      short-circuits on the first failing stage.  It binds looser than the    #
#      boolean operators, so `a and b | c` groups as `(a and b) | c`.          #
#                                                                              #
#  3.  Commands as primaries.  The find-style predicate algebra is the boolean #
#      and comparison operators applied to command primaries: `test -f x and   #
#      test -x x`, `size > 100`, and, item by item, inside a block: `ls |      #
#      where { size > 100 }` (note 9).  A command's own options and operands   #
#      are GNU-shaped (`--name`, `--name=value`, `-x`, bundled `-xvf`, the     #
#      `--` terminator, positional operands).                                  #
#                                                                              #
#  4.  Words vs literals.  A bare word in primary position is a command (a     #
#      verb, possibly nullary); numbers and quoted strings are literals.  To   #
#      pass a word as a literal value, quote it: a word that is wholly one     #
#      quoted part is a STRING; joined with bare parts it is a WORD (note 8).  #
#                                                                              #
#  5.  Keywords.  `and`, `or`, `not` are reserved only standing alone;         #
#      `android` and `and=1` are WORDs.  They are distinct token kinds, so     #
#      command argument scanning stops at them naturally; a command or an      #
#      operand named `and` is quoted.                                          #
#                                                                              #
#  6.  Grouping.  `( ... )` contains a full Sequence, so any construct may be  #
#      parenthesized to override the precedence cascade.                       #
#                                                                              #
#  7.  Newlines.  Where a pipeline has just ended, a newline separates, as `;` #
#      does; after an operator, an opening bracket or brace, or another        #
#      newline, it is a blank, so a pipeline or a predicate continues on the   #
#      next line after its operator.  A separator may end a sequence, inside   #
#      brackets and braces too: `(a;)` is `(a)`.  A backslash before a newline #
#      joins the two lines.  In expression core v2's terms, the source reads a #
#      newline as `;` in operator position and as nothing in operand position, #
#      and drops a separator before a closing bracket, a closing brace or the  #
#      end.                                                                    #
#                                                                              #
#  8.  Quoting.  As `sh` quotes: in single quotes every character is itself;   #
#      in double quotes `\"` is a quote and `\\` a backslash, and any other    #
#      backslash is itself; outside quotes a backslash keeps the next          #
#      character as it is.  The parts of a word join: `--name="a b"c` is one   #
#      word, `--name=a bc`.  A token's span is the word as written, quotes and #
#      all; its value is the word with its quoting taken out.                  #
#                                                                              #
#  9.  Blocks.  `{ ... }` holds a Sequence that the command takes as one       #
#      argument and runs as it says: once for each item of its input (`where`, #
#      `each`, `sort-by`), or once.  A djin may declare a command's block raw: #
#      its text, from after the `{` to the `}` that closes it, is one token,   #
#      read by that djin's own dialect -- for awk, a `}` in a string, a        #
#      regular expression or a comment does not close it -- and this grammar   #
#      does not apply inside: `awk run { print $1 } | count`.                  #
#                                                                              #
#  10. Numbers and options.  A word that is wholly a number is a NUMBER, `-1`  #
#      and `-1.5` among them, and is compared numerically (`size > -1`); as a  #
#      command's argument it is handed over as written, so `ls -1` and `head   #
#      -5` are unchanged.  `-1x` is a SHORT_OPTION, `2file` and `-x.txt`       #
#      WORDs.                                                                  #
#                                                                              #
#  11. Comments.  `#` begins a comment only where a token could begin: at the  #
#      start of the input, or after a blank, a newline or a token such as `;`  #
#      or `)` -- never inside a word, so `C#`, `a#b`, `"x"#y` and              #
#      `http://h/p#frag` are words, as in `sh`.                                #
################################################################################
