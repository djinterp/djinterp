/*******************************************************************************
* djinterp [parse]                                                   token_c.def
*
* The token kinds C has and C++ does not.
*   Three of these are ordinary spellings that C++ never adopted; the rest
* are the underscore-capital forms C reserved so that a keyword could be added
* without breaking existing identifiers.  C23 gave four of them unreserved
* spellings -- `alignas`, `alignof`, `bool`, `static_assert` -- which live in
* token_shared.def; the reserved forms remain valid and are kept here, so a
* dialect table carries both and the scanner accepts either.
*   The values these names take begin at D_TOKEN_C_FIRST rather than at the
* end of the shared list, so that a C-only kind and a C++-only kind can never
* collide.  A consumer that reads both languages switches over one value
* space.
*
*
* path:      /inc/djinterp/parse/lex/token_c.def
* link(s):   TBA
* author(s): Samuel 'teer' Neal-Blim                         created: 2026.09.20
*                                                            revised: 2026.09.21
*******************************************************************************/

/*
ENTRY MACROS
============
Same contract as token_shared.def, less the `_since_cpp` column: a kind in
this file has no C++ spelling by definition, so the column would be zero on
every row.
    D_TOKEN_CLASS(_name, _label)
    D_TOKEN_PUNCT(_name, _spelling)
    D_TOKEN_KEYWORD(_name, _spelling, _since_c)
*/

#ifndef D_TOKEN_CLASS
#define D_TOKEN_CLASS(_name, _label)
#define D_TOKEN_CLASS_UNDEF_ 1
#endif

#ifndef D_TOKEN_PUNCT
#define D_TOKEN_PUNCT(_name, _spelling)
#define D_TOKEN_PUNCT_UNDEF_ 1
#endif

#ifndef D_TOKEN_KEYWORD
#define D_TOKEN_KEYWORD(_name, _spelling, _since_c)
#define D_TOKEN_KEYWORD_UNDEF_ 1
#endif


//  keywords, unreserved spellings ---------------------------------------------
//                  name                   spelling             since C
D_TOKEN_KEYWORD(KW_RESTRICT,              "restrict",           1999)
D_TOKEN_KEYWORD(KW_TYPEOF,                "typeof",             2023)
D_TOKEN_KEYWORD(KW_TYPEOF_UNQUAL,         "typeof_unqual",      2023)

//  keywords, reserved spellings -----------------------------------------------
D_TOKEN_KEYWORD(KW_ALIGNAS_RESERVED,      "_Alignas",           2011)
D_TOKEN_KEYWORD(KW_ALIGNOF_RESERVED,      "_Alignof",           2011)
D_TOKEN_KEYWORD(KW_ATOMIC,                "_Atomic",            2011)
D_TOKEN_KEYWORD(KW_BITINT,                "_BitInt",            2023)
D_TOKEN_KEYWORD(KW_BOOL_RESERVED,         "_Bool",              1999)
D_TOKEN_KEYWORD(KW_COMPLEX,               "_Complex",           1999)
D_TOKEN_KEYWORD(KW_DECIMAL32,             "_Decimal32",         2023)
D_TOKEN_KEYWORD(KW_DECIMAL64,             "_Decimal64",         2023)
D_TOKEN_KEYWORD(KW_DECIMAL128,            "_Decimal128",        2023)
D_TOKEN_KEYWORD(KW_GENERIC,               "_Generic",           2011)
D_TOKEN_KEYWORD(KW_IMAGINARY,             "_Imaginary",         1999)
D_TOKEN_KEYWORD(KW_NORETURN,              "_Noreturn",          2011)
D_TOKEN_KEYWORD(KW_STATIC_ASSERT_RESERVED,"_Static_assert",     2011)
D_TOKEN_KEYWORD(KW_THREAD_LOCAL_RESERVED, "_Thread_local",      2011)


#ifdef D_TOKEN_CLASS_UNDEF_
#undef D_TOKEN_CLASS
#undef D_TOKEN_CLASS_UNDEF_
#endif

#ifdef D_TOKEN_PUNCT_UNDEF_
#undef D_TOKEN_PUNCT
#undef D_TOKEN_PUNCT_UNDEF_
#endif

#ifdef D_TOKEN_KEYWORD_UNDEF_
#undef D_TOKEN_KEYWORD
#undef D_TOKEN_KEYWORD_UNDEF_
#endif
