// D_STANDALONE_MAIN
//   macro: one-shot standalone runner execution suitable for main().
// Initializes runner, optionally parses CLI args, executes, cleans up,
// and evaluates to the exit code.
//
// Usage:
//   int main(int argc, char* argv[])
//   {
//       return D_STANDALONE_MAIN("My Suite", "Testing all the things",
//                                argc, argv,
//                                D_STANDALONE_MODULE("mod1", "desc",
//                                                    my_mod1_fn),
//                                D_STANDALONE_MODULE("mod2", "desc",
//                                                    my_mod2_fn));
//   }
#define D_STANDALONE_MODULE(_name, _desc, _fn)                               \
    { (_name), (_desc), (_fn), NULL, 0, NULL }

#define D_STANDALONE_MODULE_COUNTER(_name, _desc, _fn)                       \
    { (_name), (_desc), NULL, (_fn), 0, NULL }

#define D_STANDALONE_MODULE_NOTES(_name, _desc, _fn, _nc, _notes)            \
    { (_name), (_desc), (_fn), NULL, (_nc), (_notes) }


