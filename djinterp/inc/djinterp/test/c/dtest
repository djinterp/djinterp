/******************************************************************************
 * ASSERT-AND-RETURN MACROS
 *
 *   Evaluate an assertion, update a cumulative result variable, free the
 * assertion, and optionally return early on failure. Designed for use
 * inside D_TEST_BEGIN / D_TEST_END blocks.
 *****************************************************************************/

// D_ASSERT_CHECK_FREE
//   macro: evaluates a d_assert, returns its result, and frees it.
// Usage: if (D_ASSERT_CHECK_FREE(d_assert_new(...))) { ... }
#define D_ASSERT_CHECK_FREE(_assertion)                                      \
    d_internal_assert_check_free_impl(_assertion)

// d_internal_assert_check_free_impl
//   function (inline): extracts result from assertion, frees it, returns
// the result. Avoids double-evaluation in the macro.
static inline bool
d_internal_assert_check_free_impl(struct d_assert* _assertion)
{
    bool _r;

    if (!_assertion)
    {
        return false;
    }

    _r = _assertion->result;
    d_assert_free(_assertion);

    return _r;
}

// D_ASSERT_REQUIRE
//   macro: evaluates an assertion; if it fails, frees and returns false
// immediately. For use inside D_TEST_BEGIN / D_TEST_END.
#define D_ASSERT_REQUIRE(_assertion)                                         \
    do                                                                       \
    {                                                                        \
        struct d_assert* _a = (_assertion);                                  \
                                                                             \
        if ( (!_a) || (!_a->result) )                                        \
        {                                                                    \
            d_assert_free(_a);                                               \
                                                                             \
            return false;                                                    \
        }                                                                    \
                                                                             \
        d_assert_free(_a);                                                   \
    }                                                                        \
    while(0)

// D_ASSERT_REQUIRE_NONNULL
//   macro: asserts a pointer is non-NULL; returns false on failure.
// Shorthand for the common precondition check pattern.
#define D_ASSERT_REQUIRE_NONNULL(_ptr)                                       \
    D_ASSERT_REQUIRE(                                                        \
        d_assert_nonnull((_ptr),                                             \
                         "PASS: " D_STRINGIFY(_ptr) " != NULL",             \
                         "FAIL: " D_STRINGIFY(_ptr) " != NULL"))


/******************************************************************************
 * BATCH ASSERTION MACROS
 *
 *   Declare a local assertion list, add assertions to it, then finalize
 * with a combined pass/fail result. All assertions are freed at the end.
 *****************************************************************************/

// D_ASSERT_BATCH_MAX
//   constant: maximum number of assertions in a batch.
#define D_ASSERT_BATCH_MAX 64

// D_ASSERT_BATCH_BEGIN
//   macro: opens a batch assertion scope with local tracking variables.
#define D_ASSERT_BATCH_BEGIN()                                               \
    struct d_assert* _batch_assertions[D_ASSERT_BATCH_MAX];                  \
    size_t           _batch_count  = 0;                                      \
    bool             _batch_result = true;

// D_ASSERT_BATCH_ADD
//   macro: adds an assertion to the current batch, updating the overall
// result.
#define D_ASSERT_BATCH_ADD(_assertion)                                       \
    do                                                                       \
    {                                                                        \
        if (_batch_count < D_ASSERT_BATCH_MAX)                               \
        {                                                                    \
            struct d_assert* _ba = (_assertion);                             \
                                                                             \
            _batch_assertions[_batch_count++] = _ba;                         \
                                                                             \
            if ( (!_ba) || (!_ba->result) )                                   \
            {                                                                \
                _batch_result = false;                                        \
            }                                                                \
        }                                                                    \
    }                                                                        \
    while(0)

// D_ASSERT_BATCH_END
//   macro: frees all batch assertions and evaluates to the combined result.
// Usage: return D_ASSERT_BATCH_END();
#define D_ASSERT_BATCH_END()                                                 \
    d_internal_assert_batch_end_impl(_batch_assertions,                      \
                                     _batch_count,                           \
                                     _batch_result)

// d_internal_assert_batch_end_impl
//   function (inline): frees all assertions and returns cumulative result.
static inline bool
d_internal_assert_batch_end_impl(struct d_assert** _assertions,
                                 size_t            _count,
                                 bool              _result)
{
    size_t i;

    for (i = 0; i < _count; i++)
    {
        d_assert_free(_assertions[i]);
    }

    return _result;
}


/******************************************************************************
 * EVENT SHORTHAND MACROS
 *
 *   Aliases that pair specific DTestEvent values with the handler's emit
 * and listener registration functions.
 *****************************************************************************/

// event firing
#define D_TEST_FIRE_SETUP(handler, ctx)                                      \
    D_TEST_FIRE_EVENT((handler), D_TEST_EVENT_SETUP, (ctx))

#define D_TEST_FIRE_START(handler, ctx)                                      \
    D_TEST_FIRE_EVENT((handler), D_TEST_EVENT_START, (ctx))

#define D_TEST_FIRE_SUCCESS(handler, ctx)                                    \
    D_TEST_FIRE_EVENT((handler), D_TEST_EVENT_SUCCESS, (ctx))

#define D_TEST_FIRE_FAILURE(handler, ctx)                                    \
    D_TEST_FIRE_EVENT((handler), D_TEST_EVENT_FAILURE, (ctx))

#define D_TEST_FIRE_END(handler, ctx)                                        \
    D_TEST_FIRE_EVENT((handler), D_TEST_EVENT_END, (ctx))

#define D_TEST_FIRE_TEARDOWN(handler, ctx)                                   \
    D_TEST_FIRE_EVENT((handler), D_TEST_EVENT_TEAR_DOWN, (ctx))

// typed listener registration
#define D_TEST_ADD_SETUP_LISTENER(handler, cb)                               \
    D_TEST_ADD_LISTENER((handler), D_TEST_EVENT_SETUP, (cb))

#define D_TEST_ADD_START_LISTENER(handler, cb)                               \
    D_TEST_ADD_LISTENER((handler), D_TEST_EVENT_START, (cb))

#define D_TEST_ADD_SUCCESS_LISTENER(handler, cb)                             \
    D_TEST_ADD_LISTENER((handler), D_TEST_EVENT_SUCCESS, (cb))

#define D_TEST_ADD_FAILURE_LISTENER(handler, cb)                             \
    D_TEST_ADD_LISTENER((handler), D_TEST_EVENT_FAILURE, (cb))

#define D_TEST_ADD_END_LISTENER(handler, cb)                                 \
    D_TEST_ADD_LISTENER((handler), D_TEST_EVENT_END, (cb))

#define D_TEST_ADD_TEARDOWN_LISTENER(handler, cb)                            \
    D_TEST_ADD_LISTENER((handler), D_TEST_EVENT_TEAR_DOWN, (cb))

// D_TEST_ADD_LISTENER_DISABLED
//   macro: registers a listener in the disabled state.
#define D_TEST_ADD_LISTENER_DISABLED(handler, event_id, cb)                  \
    d_test_handler_register_listener((handler), (event_id), (cb), false)

// combined register-and-fire
#define D_TEST_ADD_AND_FIRE(handler, event_id, cb, ctx)                      \
    do                                                                       \
    {                                                                        \
        D_TEST_ADD_LISTENER((handler), (event_id), (cb));                    \
        D_TEST_FIRE_EVENT((handler), (event_id), (ctx));                     \
    }                                                                        \
    while(0)

#define D_TEST_ADD_SETUP_AND_FIRE(handler, cb, ctx)                          \
    D_TEST_ADD_AND_FIRE((handler), D_TEST_EVENT_SETUP, (cb), (ctx))

#define D_TEST_ADD_START_AND_FIRE(handler, cb, ctx)                          \
    D_TEST_ADD_AND_FIRE((handler), D_TEST_EVENT_START, (cb), (ctx))


/******************************************************************************
 * SESSION CONVENIENCE MACROS
 *
 *   One-shot macros for common session workflows: create, run, report,
 * clean up.
 *****************************************************************************/

// D_TEST_SESSION_RUN_AND_REPORT
//   macro: runs a session, writes its summary, and evaluates to whether
// all tests passed. Suitable for returning from main.
#define D_TEST_SESSION_RUN_AND_REPORT(_session)                              \
    d_internal_session_run_and_report_impl(_session)

// d_internal_session_run_and_report_impl
//   function (inline): runs the session, writes summary, returns pass/fail.
static inline bool
d_internal_session_run_and_report_impl(struct d_test_session* _session)
{
    if (!_session)
    {
        return false;
    }

    d_test_session_run(_session);
    d_test_session_write_summary(_session);

    return d_test_session_all_passed(_session);
}

// D_TEST_SESSION_MAIN
//   macro: one-shot session execution suitable for a main() return value.
// Creates the session, runs it, writes a summary, extracts the exit code,
// and frees the session.
//
// Usage:
//   int main(void)
//   {
//       return D_TEST_SESSION_MAIN(
//           D_TEST_SESSION(module1, module2, module3)
//       );
//   }
#define D_TEST_SESSION_MAIN(_session_expr)                                   \
    d_internal_session_main_impl(_session_expr)

// d_internal_session_main_impl
//   function (inline): full lifecycle for a session as a main() body.
static inline int
d_internal_session_main_impl(struct d_test_session* _session)
{
    int exit_code;

    if (!_session)
    {
        fprintf(stderr, "[DTest] Failed to create test session.\n");

        return 1;
    }

    d_test_session_run(_session);
    d_test_session_write_summary(_session);
    exit_code = d_test_session_exit_code(_session);
    d_test_session_free(_session);

    return exit_code;
}

// D_TEST_HANDLER_RUN_AND_REPORT
//   macro: runs all children in a module through a handler, prints results,
// and evaluates to the handler's pass rate being 100%.
#define D_TEST_HANDLER_RUN_AND_REPORT(_handler, _module, _label)             \
    d_internal_handler_run_and_report_impl((_handler), (_module), (_label))

// d_internal_handler_run_and_report_impl
//   function (inline): runs module, prints results, returns success.
static inline bool
d_internal_handler_run_and_report_impl(struct d_test_handler* _handler,
                                       struct d_test_module*  _module,
                                       const char*            _label)
{
    bool result;

    if ( (!_handler) || (!_module) )
    {
        return false;
    }

    result = d_test_handler_run_module(_handler, _module, NULL);
    d_test_handler_print_results(_handler, _label);

    return result;
}


