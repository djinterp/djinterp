/******************************************************************************
 * TRACKED ASSERTION MACROS
 *
 *   Each macro creates an assertion, records it in the handler's statistics,
 * and frees it. The handler accumulates pass/fail counts automatically.
 *****************************************************************************/

// D_ASSERT_TRACK
//   macro: assert a boolean condition and record result in handler.
#define D_ASSERT_TRACK(handler, condition, msg_true, msg_false)              \
    do                                                                       \
    {                                                                        \
        struct d_assert* _a =                                                \
            d_assert_new((condition), (msg_true), (msg_false));              \
                                                                             \
        d_test_handler_record_assertion((handler), _a);                      \
        d_assert_free(_a);                                                   \
    }                                                                        \
    while(0)

