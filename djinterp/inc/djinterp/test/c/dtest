/******************************************************************************
 * AUTO-MESSAGE TRACKED ASSERTION MACROS
 *
 *   Combines auto-generated pass/fail messages (from D_ASSERTION_*) with
 * handler tracking (from D_ASSERT_*_TRACK). The expression text becomes
 * the message.
 *****************************************************************************/

// D_ASSERT_TRUE_T
//   macro: assert true with auto-messages and handler tracking.
#define D_ASSERT_TRUE_T(handler, condition)                                  \
    D_ASSERT_TRACK((handler), (condition),                                   \
                   "PASS: " D_STRINGIFY(condition),                          \
                   "FAIL: " D_STRINGIFY(condition))

// D_ASSERT_FALSE_T
//   macro: assert false with auto-messages and handler tracking.
#define D_ASSERT_FALSE_T(handler, condition)                                 \
    D_ASSERT_TRACK((handler), !(condition),                                  \
                   "PASS: !" D_STRINGIFY(condition),                         \
                   "FAIL: !" D_STRINGIFY(condition))

// D_ASSERT_EQ_T
//   macro: assert equality with auto-messages and handler tracking.
#define D_ASSERT_EQ_T(handler, a, b, cmp)                                   \
    D_ASSERT_EQ_TRACK((handler), (a), (b), (cmp),                           \
                      "PASS: " D_STRINGIFY(a) " == " D_STRINGIFY(b),        \
                      "FAIL: " D_STRINGIFY(a) " == " D_STRINGIFY(b))

// D_ASSERT_NEQ_T
//   macro: assert inequality with auto-messages and handler tracking.
#define D_ASSERT_NEQ_T(handler, a, b, cmp)                                  \
    D_ASSERT_NEQ_TRACK((handler), (a), (b), (cmp),                          \
