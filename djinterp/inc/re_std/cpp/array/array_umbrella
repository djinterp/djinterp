/*******************************************************************************
* djinterp [re_std]                                               array_umbrella
*
* array umbrella header:
*   Convenience header that #includes every granular module under
* re_std/array/. Matches the project convention: user code may
* #include "re_std/array" instead of pulling in each piece directly.
*
*   Per-symbol headers (preferred for build-time minimisation):
*
*     array.hpp                       - class array<_Type, _Size>
*                                     - C++17 deduction guide
*     array_get.hpp                   - get<I>(array)  (4 overloads)
*     array_compare.hpp               - ==  !=  <  <=  >  >=
*     array_compare_three_way.hpp     - <=>             (C++20)
*     array_swap.hpp                  - swap(array&, array&)
*     to_array.hpp                    - to_array(T(&)[N]) (C++11 back-port)
*                                     - to_array(T(&&)[N])
*     array_tuple_size.hpp            - tuple_size<array>
*     array_tuple_element.hpp         - tuple_element<I, array>
*
*
* path:      /inc/re_std/cpp/array/array_umbrella
* link(s):   TBA
* author(s): TBA                                             created: 2026.05.19
*                                                            revised: 2026.10.01
*******************************************************************************/

#ifndef RE_STD_ARRAY_ARRAY_UMBRELLA
#define RE_STD_ARRAY_ARRAY_UMBRELLA 1

// FROM C++98: the array is C++98's now (array.hpp), for math's geometry,
// whose floor is C++98.
#include "../config.hpp"  // RE_STD_* configuration

// every level: the array, its get<I>, comparisons and swap
#include "./array.hpp"
#include "./array_get.hpp"
#include "./array_compare.hpp"
#include "./array_swap.hpp"
// each of these keeps its own level (three-way comparison C++20's; to_array
// C++11's; the tuple protocol C++11's, where re_std's tuple is)
#include "./array_compare_three_way.hpp"
#include "./to_array.hpp"
#include "./array_tuple_size.hpp"
#include "./array_tuple_element.hpp"


#endif  // RE_STD_ARRAY_ARRAY_UMBRELLA
