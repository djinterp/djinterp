/*******************************************************************************
* djinterp [re_std]                                            expected_umbrella
*
* expected umbrella header:
*   Convenience header that #includes every granular module under
* re_std/expected/. Matches the project convention: user code may
* #include "re_std/expected" instead of pulling in each piece directly.
*
*   Per-symbol headers:
*
*     unexpect.hpp                - unexpect_t tag + unexpect constant
*     bad_expected_access.hpp     - exception thrown by expected::value()
*     unexpected.hpp              - unexpected<E> error-wrapper class
*     unexpected_compare.hpp      - operator== for unexpected
*     expected.hpp                - expected<T, E> + expected<void, E>
*     expected_compare.hpp        - operator== overloads for expected
*     expected_swap.hpp           - non-member swap
*
*   PORTABILITY:
*   C++98 and up, in two tiers. From C++11 the classes use variadic
* templates, rvalue refs, defaulted/deleted special members, and a
* union with non-trivial members. Below C++11 a C++98 tier gives the
* same names and states by copy, over raw aligned storage; it omits
* what C++98 cannot spell (moves, in_place, the monadic operations,
* operator bool), so code written to it means the same at every level.
*
*
* path:      /inc/re_std/expected/expected_umbrella
* link(s):   TBA
* author(s): TBA                                             created: 2026.05.19
*                                                            revised: 2026.10.04
*******************************************************************************/

#ifndef RE_STD_EXPECTED_EXPECTED_UMBRELLA
#define RE_STD_EXPECTED_EXPECTED_UMBRELLA 1

#include "./unexpect.hpp"
#include "./bad_expected_access.hpp"
#include "./unexpected.hpp"
#include "./unexpected_compare.hpp"
#include "./expected.hpp"
#include "./expected_compare.hpp"
#include "./expected_swap.hpp"


#endif  // RE_STD_EXPECTED_EXPECTED_UMBRELLA
