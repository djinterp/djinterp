/*******************************************************************************
* djinterp [re_std]                                                      version
*
* version umbrella header:
* re_std's <version>. The standard <version> (C++20) is the aggregator of
* every __cpp_lib_* library feature-test macro. re_std surfaces those by
* including the platform <version> when the language is C++20 or later —
* the __cpp_lib_* macros describe std's library and cannot be
* reimplemented, so they are surfaced unchanged (an identity re-export).
*
* Before C++20 there is no aggregator header; the per-feature __cpp_lib_*
* macros (C++17) live in their individual headers. re_std's own capability
* signalling pre-C++20 is its own RE_STD_* detection (config.hpp and the
* probes beside each facility), NOT __cpp_lib_* — this header is
* intentionally a no-op there.
*
*
* path:      /inc/re_std/version/version
* link(s):   TBA
* author(s): Samuel 'teer' Neal-Blim                         created: 2026.08.25
*                                                            revised: 2026.10.01
*******************************************************************************/
#ifndef RE_STD_VERSION_VERSION
#define RE_STD_VERSION_VERSION 1
#include "../config.hpp"  // RE_STD_* configuration
#if RE_STD_LANG_IS_CPP20_OR_HIGHER
#  if defined(__has_include)
#    if __has_include(<version>)
#      include <version>
#    endif
#  else
#    include <version>
#  endif
#endif
#endif  // RE_STD_VERSION_VERSION
