              11. Maintenance
    3.  Swapping
2.  COST
    ----
    1.  Sizes and moves
*/

#ifndef DJINTERP_DB_MARIADB_MARIADB_FACE_HPP
#define DJINTERP_DB_MARIADB_MARIADB_FACE_HPP 1

// std
#include <cstddef>  // std::size_t
#include <string>   // std::string
#include <vector>   // std::vector
// djinterp
#include "../db_face.hpp"  // string_arg, text, the lists, the levels
#include "../../../c/db/mariadb/mariadb.h"     // the layer
// re_std
#include "../../../../re_std/cpp/cstdint/cstdint.hpp"  // re_std::int64_t, INT64_MAX

// std, by level: what the forms each level adds take and return
// (db_face.hpp, 1)
#if D_ENV_LANG_IS_CPP11_OR_HIGHER
    #include <type_traits>  // std::is_nothrow_move_constructible
#endif  // D_ENV_LANG_IS_CPP11_OR_HIGHER
#if D_INTERNAL_DB_FACE_OPTIONAL
    #include <optional>  // std::optional
#endif  // D_INTERNAL_DB_FACE_OPTIONAL
#if D_INTERNAL_DB_FACE_SPAN
    #include <span>  // std::span
#endif  // D_INTERNAL_DB_FACE_SPAN
#if D_INTERNAL_DB_FACE_EXPECTED
    #include <expected>  // std::expected, std::unexpected
#endif  // D_INTERNAL_DB_FACE_EXPECTED

// 64-bit floor: the layer needs a 64-bit integer type, and below it the face
// compiles to nothing, as db_face.hpp does.
#if defined(INT64_MAX)


namespace djinterp
{
namespace face
{


//==============================================================================
// 1.  FACE
//==============================================================================


// 1.1    The statement
//------------------------------------------------------------------------------
// 1.1.1
// mariadb_statement
//   class: a prepared statement -- the layer's struct dj_mariadb_statement,
// over the client's MYSQL_STMT -- owned: finalized when the object goes.
// Made empty, and filled by face::mariadb's prepare and preparef; every
// function of mariadb_statement.h that takes a statement is a member of the
// same name, whose contract it keeps. Finalize it before closing its
// connection. Not copyable; movable from C++11.
class mariadb_statement
{
public:
    // 1.1.1.1
    // Ownership
    //   a statement made empty holds none; whatever a statement holds, it
    // finalizes when it goes.
    D_CONSTEXPR mariadb_statement() D_NOEXCEPT
        : m_statement(D_NULLPTR)
    {}

    /**
     * @brief Makes a statement that owns one prepared elsewhere.
     *
     * @param[in] _owned  the statement, or `NULL` for none.
     * @post The object finalizes `_owned`; the caller no longer does.
     */
    explicit D_CONSTEXPR mariadb_statement(
        struct dj_mariadb_statement* _owned
    ) D_NOEXCEPT
        : m_statement(_owned)
    {}

    ~mariadb_statement()
    {
        // a statement, when there is one; an empty object calls nothing
        if (m_statement)
        {
            (void)d_mariadb_finalize(m_statement);
        }
    }

#if D_MOVE_ENABLED
    // moving -- the statement passes to the object moved to, which
    // finalizes what it held; the object moved from holds none
    mariadb_statement(
        mariadb_statement&& _other
    ) D_NOEXCEPT
        : m_statement(_other.release())
    {}

    mariadb_statement&
    operator=(
        mariadb_statement&& _other
    ) D_NOEXCEPT
    {
        reset(_other.release());

        return *this;
    }
#endif  // D_MOVE_ENABLED

    // the handle -- the statement, for the layer's own calls, NULL when
    // there is none; and whether there is one
    D_NODISCARD struct dj_mariadb_statement*
    handle() const D_NOEXCEPT
    {
        return m_statement;
    }

    D_NODISCARD bool
    is_prepared() const D_NOEXCEPT
    {
        return (m_statement != D_NULLPTR);
    }

#if D_ENV_LANG_IS_CPP11_OR_HIGHER
    D_EXPLICIT_BOOL operator bool() const D_NOEXCEPT
    {
        return is_prepared();
    }
#endif  // D_ENV_LANG_IS_CPP11_OR_HIGHER

    /**
     * @brief Gives up the statement without finalizing it.
     *
     * @return the statement, which the caller then finalizes with
     *         d_mariadb_finalize; `NULL` when there is none.
     * @post The object holds no statement.
     */
    D_NODISCARD struct dj_mariadb_statement*
    release() D_NOEXCEPT
    {
        struct dj_mariadb_statement* const held = m_statement;

        m_statement = D_NULLPTR;

        return held;
    }

    /**
     * @brief Finalizes the statement held, if any, and takes another.
     *
     * @param[in] _owned  the statement to own, or `NULL` for none; the one
     *                    already held is kept, not finalized.
     * @post The statement that was held, if another, is finalized.
     */
    void
    reset(
        struct dj_mariadb_statement* _owned = D_NULLPTR
    ) D_NOEXCEPT
    {
        // what is held is finalized, unless it is what comes
        if (_owned != m_statement)
        {
            // a statement, when there is one
            if (m_statement)
            {
                (void)d_mariadb_finalize(m_statement);
            }

            m_statement = _owned;
        }

        return;
    }

    /**
     * @brief Finalizes the statement, as d_mariadb_finalize does.
     *
     * @return d_mariadb_finalize's result: 0, or the client's error
     *         number when the server could not be told.
     * @post The object holds no statement, whatever the result.
     */
    int
    finalize() D_NOEXCEPT
    {
        return d_mariadb_finalize(release());
    }

    /**
     * @brief Finalizes the statement held, if any, and hands its slot to a
     *        layer's prepare to fill.
     *
     * @return where the layer writes the statement it prepares; the object
     *         owns what is written there.
     * @post The object holds no statement until the prepare fills the slot,
     *       and holds none when the prepare fails.
     */
    struct dj_mariadb_statement**
    out() D_NOEXCEPT
    {
        reset();

        return &m_statement;
    }

    // swap -- the two objects trade statements
    void
    swap(
        mariadb_statement& _other
    ) D_NOEXCEPT
    {
        struct dj_mariadb_statement* const held = m_statement;

        m_statement        = _other.m_statement;
        _other.m_statement = held;

        return;
    }

    // 1.1.1.2
    // Describing, binding and running
    //   mariadb_statement.h's functions that take a statement.
    @@MEMBERS mariadb_statement.h statement@@

private:
    D_DELETED_FN_MSG(mariadb_statement(const mariadb_statement&),
                     "a statement owns what the server prepared; move it")
    D_DELETED_FN_MSG(mariadb_statement& operator=(const mariadb_statement&),
                     "a statement owns what the server prepared; move it")

    struct dj_mariadb_statement* m_statement;
};

// 1.2    The connection
//------------------------------------------------------------------------------
// 1.2.1
// mariadb
//   class: a MariaDB or MySQL connection, owned: closed when the object goes.
// Every member forwards to the layer's function of the same name, whose
// contract it keeps. Not copyable; movable from C++11.
class mariadb
{
public:
    // transaction_mode
    //   type: how a transaction begins, for face::transaction.
    typedef enum dj_mariadb_transaction_mode transaction_mode;

#if D_ENV_LANG_IS_CPP11_OR_HIGHER
    // format
    //   type: an f form's format, for the arguments that follow it: a
    // literal in the shared dialect, read at compile time from C++20, or a
    // format runtime_format marked (db_face.hpp, 2.3).
    template<typename... Args>
    using format = format_arg<internal::shared_dialect, Args...>;
#endif  // D_ENV_LANG_IS_CPP11_OR_HIGHER

    // 1.2.1.1
    // Ownership
    //   a face made empty holds no connection; whatever a face holds, it
    // closes when it goes.
    D_CONSTEXPR mariadb() D_NOEXCEPT
        : m_db(D_NULLPTR)
    {}

    /**
     * @brief Makes a face that owns a handle made elsewhere: by the layer,
     *        or by d_mariadb_adopt.
     *
     * @param[in] _owned  the handle, or `NULL` for none.
     * @post The face closes `_owned`; the caller no longer does.
     */
    explicit D_CONSTEXPR mariadb(
        struct dj_mariadb* _owned
    ) D_NOEXCEPT
        : m_db(_owned)
    {}

    ~mariadb()
    {
        // a connection, when there is one; an empty face calls nothing
        if (m_db)
        {
            (void)d_mariadb_close(m_db);
        }
    }

#if D_MOVE_ENABLED
    // moving -- the connection passes to the face moved to, which closes
    // what it held; the face moved from holds none
    mariadb(
        mariadb&& _other
    ) D_NOEXCEPT
        : m_db(_other.release())
    {}

    mariadb&
    operator=(
        mariadb&& _other
    ) D_NOEXCEPT
    {
        reset(_other.release());

        return *this;
    }
#endif  // D_MOVE_ENABLED

    // the handle -- the layer's handle, for its calls, NULL when there is
    // none (native() is the client's MYSQL*); and whether there is one
    D_NODISCARD struct dj_mariadb*
    handle() const D_NOEXCEPT
    {
        return m_db;
    }

    D_NODISCARD bool
    is_open() const D_NOEXCEPT
    {
        return (m_db != D_NULLPTR);
    }

#if D_ENV_LANG_IS_CPP11_OR_HIGHER
    D_EXPLICIT_BOOL operator bool() const D_NOEXCEPT
    {
        return is_open();
    }
#endif  // D_ENV_LANG_IS_CPP11_OR_HIGHER

    /**
     * @brief Gives up the handle without closing it.
     *
     * @return the handle, which the caller then closes with
     *         d_mariadb_close; `NULL` when there is none.
     * @post The face holds no connection.
     */
    D_NODISCARD struct dj_mariadb*
    release() D_NOEXCEPT
    {
        struct dj_mariadb* const held = m_db;

        m_db = D_NULLPTR;

        return held;
    }

    /**
     * @brief Closes the handle held, if any, and takes another.
     *
     * @param[in] _owned  the handle to own, or `NULL` for none; the one
     *                    already held is kept, not closed.
     * @post The handle that was held, if another, is closed, and every
     *       pointer obtained through it is invalid.
     */
    void
    reset(
        struct dj_mariadb* _owned = D_NULLPTR
    ) D_NOEXCEPT
    {
        // what is held closes, unless it is what comes
        if (_owned != m_db)
        {
            // a connection, when there is one
            if (m_db)
            {
                (void)d_mariadb_close(m_db);
            }

            m_db = _owned;
        }

        return;
    }

    // swap -- the two faces trade connections
    void
    swap(
        mariadb& _other
    ) D_NOEXCEPT
    {
        struct dj_mariadb* const held = m_db;

        m_db        = _other.m_db;
        _other.m_db = held;

        return;
    }

    // default_transaction_mode -- how face::transaction begins when told
    // nothing: READ WRITE
    D_NODISCARD static D_CONSTEXPR transaction_mode
    default_transaction_mode() D_NOEXCEPT
    {
        return D_MARIADB_TRANSACTION_READ_WRITE;
    }

    // 1.2.1.2
    // Library
    //   mariadb_common.h's client versions and result messages: static,
    // since they need no connection.
    @@MEMBERS mariadb_common.h static@@

    // 1.2.1.3
    // Servers and errors
    //   mariadb_common.h's server flavor, versions and features, the
    // client's own handle, and the connection's latest error.
    @@MEMBERS mariadb_common.h instance@@

    // 1.2.1.4
    // Connections
    //   mariadb_connection.h.

    /**
     * @brief Connects to a server, as d_mariadb_connect does, in place of
     *        the connection held.
     *
     * @param[in] _options  where and as whom; `NULL` connects with every
     *                      field defaulted.
     * @return d_mariadb_connect's result.
     * @post On success the face holds the new connection, and the one it
     *       held is closed; on failure the face is as it was.
     */
    int
    connect(
        const struct dj_mariadb_options* _options
    ) D_NOEXCEPT
    {
        struct dj_mariadb* made   = D_NULLPTR;
        const int         result = d_mariadb_connect(_options, &made);

        return m_take(result, made);
    }

    /**
     * @brief Connects to a server with client settings applied first, as
     *        d_mariadb_connect_with does, in place of the connection held.
     *
     * @param[in] _options   where and as whom; `NULL` connects with every
     *                       field defaulted.
     * @param[in] _settings  the settings, applied in order.
     * @param[in] _count     how many there are.
     * @return d_mariadb_connect_with's result.
     * @post As for connect.
     */
    int
    connect_with(
        const struct dj_mariadb_options* _options,
        const struct dj_mariadb_setting* _settings,
        std::size_t                     _count
    ) D_NOEXCEPT
    {
        struct dj_mariadb* made   = D_NULLPTR;
        const int         result = d_mariadb_connect_with(_options,
                                                          _settings,
                                                          _count,
                                                          &made,
                                                          D_NULLPTR);

        return m_take(result, made);
    }

    /**
     * @brief Connects as connect_with does, and says why a connection could
     *        not be made.
     *
     * @param[in]  _options   where and as whom; `NULL` connects with every
     *                        field defaulted.
     * @param[in]  _settings  the settings, applied in order.
     * @param[in]  _count     how many there are.
     * @param[out] _message   the reason when no connection was made, in the
     *                        client's words or the layer's; null otherwise.
     * @return d_mariadb_connect_with's result.
     * @post As for connect.
     */
    int
    connect_with(
        const struct dj_mariadb_options* _options,
        const struct dj_mariadb_setting* _settings,
        std::size_t                     _count,
        text&                           _message
    ) D_NOEXCEPT
    {
        struct dj_mariadb* made   = D_NULLPTR;
        const int         result = d_mariadb_connect_with(_options,
                                                          _settings,
                                                          _count,
                                                          &made,
                                                          _message.out());

        return m_take(result, made);
    }

    // connect_with -- the settings as an array, its size the count; from
    // C++20 as a std::span; each with the reason too
    template<std::size_t Count>
    int
    connect_with(
        const struct dj_mariadb_options* _options,
        const struct dj_mariadb_setting  (&_settings)[Count]
    ) D_NOEXCEPT
    {
        return connect_with(_options, _settings, Count);
    }

    template<std::size_t Count>
    int
    connect_with(
        const struct dj_mariadb_options* _options,
        const struct dj_mariadb_setting  (&_settings)[Count],
        text&                           _message
    ) D_NOEXCEPT
    {
        return connect_with(_options, _settings, Count, _message);
    }

#if D_INTERNAL_DB_FACE_SPAN
    int
    connect_with(
        const struct dj_mariadb_options*           _options,
        std::span<const struct dj_mariadb_setting> _settings
    ) noexcept
    {
        return connect_with(_options, _settings.data(), _settings.size());
    }

    int
    connect_with(
        const struct dj_mariadb_options*           _options,
        std::span<const struct dj_mariadb_setting> _settings,
        text&                                     _message
    ) noexcept
    {
        return connect_with(_options,
                            _settings.data(),
                            _settings.size(),
                            _message);
    }
#endif  // D_INTERNAL_DB_FACE_SPAN

    /**
     * @brief Wraps a connection made with the client's own calls, as
     *        d_mariadb_adopt does, in place of the connection held.
     *
     * @param[in] _native  a connected MYSQL*, which is left as it is.
     * @param[in] _owned   whether closing the face closes it as well.
     * @return d_mariadb_adopt's result.
     * @post As for connect; on failure `_native` is the caller's, whatever
     *       `_owned` said.
     */
    int
    adopt(
        void* _native,
        bool  _owned
    ) D_NOEXCEPT
    {
        struct dj_mariadb* made   = D_NULLPTR;
        const int         result = d_mariadb_adopt(_native, _owned, &made);

        return m_take(result, made);
    }

    /**
     * @brief Closes the connection, as d_mariadb_close does.
     *
     * @return 0.
     * @post The face holds no connection.
     */
    int
    close() D_NOEXCEPT
    {
        return d_mariadb_close(release());
    }

    /**
     * @brief Starts a connection, as d_mariadb_connect_start does, to
     *        replace the connection held.
     *
     * @param[in]  _options  where and as whom; `NULL` connects with every
     *                       field defaulted.
     * @param[out] _pending  receives what to wait for before continuing.
     * @return d_mariadb_connect_start's result.
     * @post On D_DB_WAIT the face holds the connection being made, and on 0
     *       the connection made, the one it held closed either way; on
     *       failure the face is as it was.
     */
    int
    connect_start(
        const struct dj_mariadb_options* _options,
        dj_db_pending&                   _pending
    ) D_NOEXCEPT
    {
        struct dj_mariadb* made   = D_NULLPTR;
        const int         result = d_mariadb_connect_start(_options,
                                                           &made,
                                                           &_pending);

        return m_take_started(result, made);
    }

    /**
     * @brief Starts a connection with client settings applied first, as
     *        d_mariadb_connect_with_start does, to replace the connection
     *        held.
     *
     * @param[in]  _options   where and as whom; `NULL` connects with every
     *                        field defaulted.
     * @param[in]  _settings  the settings, applied in order.
     * @param[in]  _count     how many there are.
     * @param[out] _pending   receives what to wait for before continuing.
     * @return d_mariadb_connect_with_start's result.
     * @post As for connect_start.
     */
    int
    connect_with_start(
        const struct dj_mariadb_options* _options,
        const struct dj_mariadb_setting* _settings,
        std::size_t                     _count,
        dj_db_pending&                   _pending
    ) D_NOEXCEPT
    {
        struct dj_mariadb* made   = D_NULLPTR;
        const int         result = d_mariadb_connect_with_start(_options,
                                                                _settings,
                                                                _count,
                                                                &made,
                                                                &_pending,
                                                                D_NULLPTR);

        return m_take_started(result, made);
    }

    /**
     * @brief Starts a connection as connect_with_start does, and says why
     *        one could not be.
     *
     * @param[in]  _options   where and as whom; `NULL` connects with every
     *                        field defaulted.
     * @param[in]  _settings  the settings, applied in order.
     * @param[in]  _count     how many there are.
     * @param[out] _pending   receives what to wait for before continuing.
     * @param[out] _message   the reason when no connection was made, in the
     *                        client's words or the layer's; null otherwise.
     * @return d_mariadb_connect_with_start's result.
     * @post As for connect_start.
     */
    int
    connect_with_start(
        const struct dj_mariadb_options* _options,
        const struct dj_mariadb_setting* _settings,
        std::size_t                     _count,
        dj_db_pending&                   _pending,
        text&                           _message
    ) D_NOEXCEPT
    {
        struct dj_mariadb* made   = D_NULLPTR;
        const int         result = d_mariadb_connect_with_start(
                                       _options,
                                       _settings,
                                       _count,
                                       &made,
                                       &_pending,
                                       _message.out());

        return m_take_started(result, made);
    }

    // connect_with_start -- the settings as an array, its size the count;
    // from C++20 as a std::span; each with the reason too
    template<std::size_t Count>
    int
    connect_with_start(
        const struct dj_mariadb_options* _options,
        const struct dj_mariadb_setting  (&_settings)[Count],
        dj_db_pending&                   _pending
    ) D_NOEXCEPT
    {
        return connect_with_start(_options, _settings, Count, _pending);
    }

    template<std::size_t Count>
    int
    connect_with_start(
        const struct dj_mariadb_options* _options,
        const struct dj_mariadb_setting  (&_settings)[Count],
        dj_db_pending&                   _pending,
        text&                           _message
    ) D_NOEXCEPT
    {
        return connect_with_start(_options,
                                  _settings,
                                  Count,
                                  _pending,
                                  _message);
    }

#if D_INTERNAL_DB_FACE_SPAN
    int
    connect_with_start(
        const struct dj_mariadb_options*           _options,
        std::span<const struct dj_mariadb_setting> _settings,
        dj_db_pending&                             _pending
    ) noexcept
    {
        return connect_with_start(_options,
                                  _settings.data(),
                                  _settings.size(),
                                  _pending);
    }

    int
    connect_with_start(
        const struct dj_mariadb_options*           _options,
        std::span<const struct dj_mariadb_setting> _settings,
        dj_db_pending&                             _pending,
        text&                                     _message
    ) noexcept
    {
        return connect_with_start(_options,
                                  _settings.data(),
                                  _settings.size(),
                                  _pending,
                                  _message);
    }
#endif  // D_INTERNAL_DB_FACE_SPAN

    /**
     * @brief Continues the connection a start began, as
     *        d_mariadb_connect_continue does.
     *
     * @param[in]     _events   what came, as dj_db_wait.
     * @param[in,out] _pending  what the start or the last continuation
     *                          wrote; receives what to wait for next.
     * @return d_mariadb_connect_continue's result.
     * @post On a failure the face holds no connection: the layer closed the
     *       one being made.
     */
    int
    connect_continue(
        unsigned      _events,
        dj_db_pending& _pending
    ) D_NOEXCEPT
    {
        struct dj_mariadb* db     = m_db;
        const int         result = d_mariadb_connect_continue(&db,
                                                              _events,
                                                              &_pending,
                                                              D_NULLPTR);

        m_db = db;

        return result;
    }

    /**
     * @brief Continues the connection as connect_continue does, and says
     *        why it could not be made.
     *
     * @param[in]     _events   what came, as dj_db_wait.
     * @param[in,out] _pending  what the start or the last continuation
     *                          wrote; receives what to wait for next.
     * @param[out]    _message  the reason when the connection could not be
     *                          made, in the client's words or the layer's;
     *                          null otherwise.
     * @return d_mariadb_connect_continue's result.
     * @post As for connect_continue.
     */
    int
    connect_continue(
        unsigned      _events,
        dj_db_pending& _pending,
        text&         _message
    ) D_NOEXCEPT
    {
        struct dj_mariadb* db     = m_db;
        const int         result = d_mariadb_connect_continue(
                                       &db,
                                       _events,
                                       &_pending,
                                       _message.out());

        m_db = db;

        return result;
    }

    /**
     * @brief Starts asking the server, from a connection of its own, to
     *        stop what this connection runs, as d_mariadb_cancel_start
     *        does.
     *
     * @param[out] _canceller  receives the request's connection, in place
     *                         of the one it held, while the request is
     *                         under way; it is continued by its own
     *                         cancel_continue.
     * @param[out] _pending    receives what to wait for before continuing.
     * @return d_mariadb_cancel_start's result.
     * @post On D_DB_WAIT `_canceller` holds the request under way, the
     *       connection it held closed; otherwise it is as it was.
     */
    int
    cancel_start(
        mariadb&      _canceller,
        dj_db_pending& _pending
    ) D_NOEXCEPT
    {
        struct dj_mariadb* made   = D_NULLPTR;
        const int         result = d_mariadb_cancel_start(m_db,
                                                          &made,
                                                          &_pending,
                                                          D_NULLPTR);

        return _canceller.m_take_request(result, made);
    }

    /**
     * @brief Starts a cancel as cancel_start does, and says why it could
     *        not be made.
     *
     * @param[out] _canceller  as for cancel_start.
     * @param[out] _pending    receives what to wait for before continuing.
     * @param[out] _message    the reason when the request failed, in the
     *                         client's words or the layer's; null
     *                         otherwise.
     * @return d_mariadb_cancel_start's result.
     * @post As for cancel_start.
     */
    int
    cancel_start(
        mariadb&      _canceller,
        dj_db_pending& _pending,
        text&         _message
    ) D_NOEXCEPT
    {
        struct dj_mariadb* made   = D_NULLPTR;
        const int         result = d_mariadb_cancel_start(m_db,
                                                          &made,
                                                          &_pending,
                                                          _message.out());

        return _canceller.m_take_request(result, made);
    }

    /**
     * @brief Continues the cancel request this face holds, as
     *        d_mariadb_cancel_continue does.
     *
     * @param[in]     _events   what came, as dj_db_wait.
     * @param[in,out] _pending  what the start or the last continuation
     *                          wrote; receives what to wait for next.
     * @return d_mariadb_cancel_continue's result.
     * @post Done, whatever the outcome, the face holds no connection: the
     *       layer closed the request's. A request abandoned is closed with
     *       the face.
     */
    int
    cancel_continue(
        unsigned      _events,
        dj_db_pending& _pending
    ) D_NOEXCEPT
    {
        struct dj_mariadb* db     = m_db;
        const int         result = d_mariadb_cancel_continue(&db,
                                                             _events,
                                                             &_pending,
                                                             D_NULLPTR);

        m_db = db;

        return result;
    }

    /**
     * @brief Continues the cancel request as cancel_continue does, and says
     *        why it failed.
     *
     * @param[in]     _events   what came, as dj_db_wait.
     * @param[in,out] _pending  what the start or the last continuation
     *                          wrote; receives what to wait for next.
     * @param[out]    _message  the reason when the request failed; null
     *                          otherwise.
     * @return d_mariadb_cancel_continue's result.
     * @post As for cancel_continue.
     */
    int
    cancel_continue(
        unsigned      _events,
        dj_db_pending& _pending,
        text&         _message
    ) D_NOEXCEPT
    {
        struct dj_mariadb* db     = m_db;
        const int         result = d_mariadb_cancel_continue(
                                       &db,
                                       _events,
                                       &_pending,
                                       _message.out());

        m_db = db;

        return result;
    }

    @@MEMBERS mariadb_connection.h all@@

    // 1.2.1.5
    // Queries
    //   mariadb_query.h; the f forms from C++11, their formats checked from
    // C++20 (db_face.hpp, 2.2 to 2.5).
    @@MEMBERS mariadb_query.h all@@

    // 1.2.1.6
    // Statements
    //   mariadb_statement.h's preparing, into a
    // face::mariadb_statement, whose members its other functions are.
    @@MEMBERS mariadb_statement.h instance@@

    // 1.2.1.7
    // Databases
    //   mariadb_database.h.
    @@MEMBERS mariadb_database.h all@@

    // 1.2.1.8
    // Schema
    //   mariadb_schema.h.
    @@MEMBERS mariadb_schema.h all@@

    // 1.2.1.9
    // Transactions
    //   mariadb_transaction.h; face::transaction and face::savepoint guard
    // them.
    @@MEMBERS mariadb_transaction.h all@@

    // 1.2.1.10
    // Settings
    //   mariadb_settings.h.
    @@MEMBERS mariadb_settings.h all@@

    // 1.2.1.11
    // Maintenance
    //   mariadb_maintenance.h.
    @@MEMBERS mariadb_maintenance.h all@@

private:
    D_DELETED_FN_MSG(mariadb(const mariadb&),
                     "a face owns its connection; move it")
    D_DELETED_FN_MSG(mariadb& operator=(const mariadb&),
                     "a face owns its connection; move it")

    // m_take -- a connect's result; the handle it made replaces the face's
    // when it succeeded. Each connect calls the layer first, in a statement
    // of its own, since the order a call's arguments are evaluated in is the
    // compiler's.
    int
    m_take(
        int               _result,
        struct dj_mariadb* _made
    ) D_NOEXCEPT
    {
        // a failed connect made nothing to keep
        if (_result == 0)
        {
            reset(_made);
        }

        return _result;
    }

    // m_take_started -- a start's result; the connection being made, or
    // made at once, replaces the face's when it answered D_DB_WAIT or 0
    int
    m_take_started(
        int               _result,
        struct dj_mariadb* _made
    ) D_NOEXCEPT
    {
        // a failed start made nothing to keep
        if ( (_result == D_DB_WAIT) ||
             (_result == 0) )
        {
            reset(_made);
        }

        return _result;
    }

    // m_take_request -- a cancel's start's result; the request's connection
    // replaces the face's while it is under way, the layer having closed it
    // otherwise
    int
    m_take_request(
        int               _result,
        struct dj_mariadb* _made
    ) D_NOEXCEPT
    {
        // a request done or failed at once left nothing to keep
        if (_result == D_DB_WAIT)
        {
            reset(_made);
        }

        return _result;
    }

    struct dj_mariadb* m_db;
};

// 1.3    Swapping
//------------------------------------------------------------------------------
// swapping -- the two connections, or statements, trade places, as std::swap
// would have them, for code that swaps unqualified
inline void
swap(
    mariadb_statement& _left,
    mariadb_statement& _right
) D_NOEXCEPT
{
    _left.swap(_right);

    return;
}

inline void
swap(
    mariadb& _left,
    mariadb& _right
) D_NOEXCEPT
{
    _left.swap(_right);

    return;
}


//==============================================================================
// 2.  COST
//==============================================================================


// 2.1    Sizes and moves
//------------------------------------------------------------------------------
// the face is its handle, and a statement its own, and from C++11 each moves
// without throwing (db_face.hpp, 6)
D_STATIC_ASSERT(sizeof(mariadb_statement) ==
                    sizeof(struct dj_mariadb_statement*),
                "face::mariadb_statement is its handle, and no more");
D_STATIC_ASSERT(sizeof(mariadb) == sizeof(struct dj_mariadb*),
                "face::mariadb is its handle, and no more");
#if D_MOVE_ENABLED
D_STATIC_ASSERT(
    ( (std::is_nothrow_move_constructible<mariadb_statement>::value) &&
      (std::is_nothrow_move_assignable<mariadb_statement>::value) ),
    "face::mariadb_statement moves without throwing");
D_STATIC_ASSERT( ( (std::is_nothrow_move_constructible<mariadb>::value) &&
                   (std::is_nothrow_move_assignable<mariadb>::value) ),
                 "face::mariadb moves without throwing");
#endif  // D_MOVE_ENABLED


}  // namespace face
}  // namespace djinterp


#endif  // defined(INT64_MAX)

#endif  // DJINTERP_DB_MARIADB_MARIADB_FACE_HPP
