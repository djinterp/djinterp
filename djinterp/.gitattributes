# djinterp: line endings
#   Every text file is CRLF in a Windows checkout and LF in the repository,
# as core.autocrlf makes it. Shell scripts are the one exception: bash
# refuses a carriage return at the end of a line, so a .sh file is LF in
# every checkout, Windows included (ruled 2026.11.05).
*.sh text eol=lf

# test inputs that are bytes, not text: no line ending is converted in any
# checkout, so each case reads exactly as it was written (the parse stress
# suite's fuzz corpus)
tests/djinterp/c/modules/parse/stress/corpus/** -text
